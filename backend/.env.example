# NASA-FLAME Backend Configuration
APP_NAME="NASA-FLAME Backend"
APP_ENV="development"
VERSION="1.0.0"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# For local SQLite development (default fallback):
DATABASE_URL="sqlite:///./nasa_flame.db"

# For PostgreSQL in staging / production:
# DATABASE_URL="postgresql://flame_user:flame_pass@localhost:5432/nasa_flame"

# CORS Configuration (comma-separated list of origins)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,*"

# Logging
LOG_LEVEL="INFO"

